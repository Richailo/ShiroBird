# Copy to .env and set unique random keys with openssl rand -hex 32
SHIROBIRD_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_ADMIN_TOKEN
SHIROBIRD_INGEST_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_INGEST_TOKEN
SHIROBIRD_PORT=8666
SHIROBIRD_COOKIE_SECURE=true
SHIROBIRD_RETENTION_DAYS=30
# Optional UDP syslog destination (transport is unencrypted; use on trusted LAN only)
SHIROBIRD_SYSLOG_HOST=
SHIROBIRD_SYSLOG_PORT=514
