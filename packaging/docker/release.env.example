# Sekrety generuje scripts/install-release.sh, gdy .env jeszcze nie istnieje.
SHIROBIRD_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHARS
SHIROBIRD_INGEST_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_CHARS
SHIROBIRD_PORT=8666
SHIROBIRD_COOKIE_SECURE=true
SHIROBIRD_RETENTION_DAYS=30
SHIROBIRD_NETBIRD_NETWORK=netbird_netbird
SHIROBIRD_BRIDGE_BIND=127.0.0.1
SHIROBIRD_BRIDGE_PORT=8082
# Optional pinned registry tags, if publishing to another account:
# SHIROBIRD_RELEASE_IMAGE=ghcr.io/YOURORG/shirobird:0.1.0-rc.1
# SHIROBIRD_RELEASE_CUSTOMIZE_IMAGE=ghcr.io/YOURORG/shirobird-customize:0.1.0-rc.1
# SHIROBIRD_RELEASE_BRIDGE_IMAGE=ghcr.io/YOURORG/shirobird-bridge:0.1.0-rc.1
# SHIROBIRD_RELEASE_NATIVE_IMAGE=ghcr.io/YOURORG/shirobird-native-flow:0.1.0-rc.1
