[Unit]
Description=ShiroBird passive conntrack flow collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/shirobird/collector.env
ExecStart=/usr/bin/python3 /usr/local/lib/shirobird-collector.py
Restart=always
RestartSec=5
User=root
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target